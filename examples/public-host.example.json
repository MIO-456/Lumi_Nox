        "title": "五子棋",
        "duration": 300,
        "activity": "gomoku"
      },
      {
        "id": "chat-2",
        "kind": "chat",
        "title": "聊天",
        "duration": 60,
        "prompt": "聊聊刚才的游戏或一个轻松的话题，不要虚构观众留言。"
      },
      {
        "id": "ending",
        "kind": "ending",
        "title": "结束",
        "duration": 15,
        "prompt": "简短感谢观众并告别，结束这场直播。"
      }
